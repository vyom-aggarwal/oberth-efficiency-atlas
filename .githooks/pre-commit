#!/bin/sh
# Pre-commit (author rules, 2026-10-18 and 2026-10-19): the checks that the staged files can affect,
# scripts/check_all.py --staged (content: check_numbers; site code: type check and vitest; the exporter, the site
# data or their sources: site-data tests; hook scripts: hook tests). Any failure blocks the commit.
# The full check_all.py (no flag) stays the gate before pushing, and runs in CI.
# Enable once per clone:  git config core.hooksPath .githooks
# The checks run on the working tree, not only on what is staged.
root=$(git rev-parse --show-toplevel) || exit 1
if [ -x "$root/.venv/Scripts/python.exe" ]; then py="$root/.venv/Scripts/python.exe"
elif [ -x "$root/.venv/bin/python" ]; then py="$root/.venv/bin/python"
else
  echo "pre-commit: no .venv found; create it as CLAUDE.md describes" >&2
  exit 1
fi
"$py" "$root/scripts/check_all.py" --staged || {
  echo "pre-commit: checks failed; commit blocked (see the summary above)" >&2
  exit 1
}
